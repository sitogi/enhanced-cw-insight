{
  "manifest_version": 3,
  "name": "Enhanced CloudWatch Insight",
  "version": "1.0",
  "description": "",
  "permissions": ["activeTab", "scripting"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.console.aws.amazon.com/cloudwatch/*"],
      "js": ["content.js"]
    }
  ]
}
